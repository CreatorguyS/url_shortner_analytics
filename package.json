{
  "name": "url-shortener-monorepo",
  "version": "2.0.0",
  "description": "Production-grade URL shortener — microservice architecture",
  "private": true,
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev": "docker-compose up --build",
    "dev:down": "docker-compose down -v",
    "migrate": "node scripts/migrate-encrypt.js",
    "gen-env": "node scripts/generate-env.js",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
