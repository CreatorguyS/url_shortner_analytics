# ─── Copy this file to .env and fill in the secrets ─────────────────────────
# Run: node scripts/generate-env.js to auto-generate this file

# ── Encryption (REQUIRED) ────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM URL encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
URL_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# 64-byte hex secret for JWT signing
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_128_CHAR_HEX

# Admin token for creating API keys (POST /auth/token)
ADMIN_TOKEN=REPLACE_WITH_STRONG_SECRET

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
BASE_URL=https://your-domain.com

# ── Ports ───────────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
URL_SERVICE_PORT=3001
REDIRECT_SERVICE_PORT=3002
ANALYTICS_SERVICE_PORT=3003
AUTH_SERVICE_PORT=3004

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo-primary:27017/url-shortener?replicaSet=rs0
MONGO_URI_SECONDARY=mongodb://mongo-secondary-1:27017,mongo-secondary-2:27017/url-shortener?replicaSet=rs0&readPreference=secondaryPreferred

# ── Redis Cluster ────────────────────────────────────────────────────────────
REDIS_CLUSTER_NODES=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379
REDIS_HOST=redis-node-1
REDIS_PORT=6379
REDIS_URL=redis://redis-node-1:6379

# ── Sharding ─────────────────────────────────────────────────────────────────
NUM_SHARDS=3

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=10
RATE_LIMIT_MAX=100
DDOS_BURST_LIMIT=500
DDOS_WINDOW_SEC=1
DDOS_BLOCK_DURATION=60

# ── Circuit Breaker ──────────────────────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30

# ── Cache TTLs ───────────────────────────────────────────────────────────────
L1_CACHE_TTL_SEC=60
L2_CACHE_TTL_SEC=3600
REDIRECT_L1_CACHE_MAX=50000
REDIRECT_L1_CACHE_TTL_SEC=60

# ── Workers ──────────────────────────────────────────────────────────────────
ANALYTICS_CONCURRENCY=20
ANALYTICS_BATCH_MS=100

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
